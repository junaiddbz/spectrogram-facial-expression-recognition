# Environment Variables — Spectrogram FER
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ─── Hugging Face ─────────────────────────────────────────────────────────────
# Your HF write token (for pushing model weights to the Hub)
HF_TOKEN=your_huggingface_write_token_here
HF_REPO_ID=your-username/spectrogram-fer

# ─── Optional: W&B Logging ────────────────────────────────────────────────────
# WANDB_API_KEY=your_wandb_key
# WANDB_PROJECT=spectrogram-fer
